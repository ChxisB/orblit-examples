<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- The Orblit packages are the versions the engine had on 2026-10-29. -->
  <ItemGroup>
    <PackageVersion Include="Orblit.Examples" Version="0.2.0" />
    <PackageVersion Include="Orblit.Filament.Avalonia" Version="0.1.0" />
    <PackageVersion Include="Orblit.Physics.Soft" Version="0.2.0" />
    <PackageVersion Include="Orblit.Script" Version="0.1.0" />
    <PackageVersion Include="Orblit.Script.Scene" Version="0.1.0" />
    <PackageVersion Include="Orblit.Script.Ui" Version="0.1.0" />
    <PackageVersion Include="Orblit.Stage" Version="0.5.0" />
  </ItemGroup>
</Project>
