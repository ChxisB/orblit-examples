<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
    <Description>The crate game played from its own program. The editor opens the same folder as a project.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Orblit.Game.Avalonia" />
    <ProjectReference Include="game\Game.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game is its own project, which the editor builds, so this one only plays it. -->
    <Compile Remove="game\**" />
    <None Include="scenes\**;orblit.project.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
