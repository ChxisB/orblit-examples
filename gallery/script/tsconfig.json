{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "lib": ["ES2020"],
    "outDir": "build",

    // Only what is in here decides the shape of the output. Without it the
    // compiler roots the output at whatever the inputs have in common, which
    // reaches outside this folder and buries the result several directories
    // down.
    "rootDir": ".",

    // No factory imported in any file: the compiler inserts the call itself.
    "jsx": "react-jsx",
    "jsxImportSource": "orblit",

    // The engine's interface library, by its types rather than its sources.
    // A published engine would ship these as an npm package and this would be
    // one line; until then it is the sibling checkout that tool/link_local.sh
    // already assumes. Pointing at the sources instead would pull them into
    // this build and recompile a library the engine already carries.
    "baseUrl": ".",
    "paths": {
      "orblit": ["../../../orblit-script/packages/orblit_script_ui/types/ui"],
      "orblit/jsx-runtime": [
        "../../../orblit-script/packages/orblit_script_ui/types/jsx-runtime"
      ],
      "orblit/scene": [
        "../../../orblit-script/packages/orblit_script_scene/types/scene"
      ]
    }
  },
  "include": [
    "*.tsx",
    "*.ts",
    "../../../orblit-script/packages/orblit_script_ui/types/jsx.d.ts"
  ]
}
